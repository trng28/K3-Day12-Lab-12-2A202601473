{
  "dataset_id": "day04_v2_academic_research_group",
  "dataset_role": "group",
  "description": "10 team-authored routing cases for the Academic Paper Research Agent: 5 single-turn and 5 multi-turn cases covering academic sources, clarification, policy, source correction, and publishing confirmation.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_arxiv_vietnamese_models",
      "phase": "B",
      "suite": "group",
      "query": "Tìm 4 paper arXiv về Vietnamese pretrained language models.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "papers",
            "args": {
              "query": "Vietnamese pretrained language models",
              "max_results": 4
            }
          }
        ]
      },
      "metadata": {
        "skill": "academic_arxiv_routing",
        "difficulty": "easy",
        "what_it_tests": "Explicit arXiv request routes only to papers and preserves topic and limit."
      }
    },
    {
      "id": "G02_semantic_scholar_legal_nlp",
      "phase": "B",
      "suite": "group",
      "query": "Tìm trên Semantic Scholar 3 paper về Vietnamese legal NLP.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "semantic_scholar",
            "args": {
              "query": "Vietnamese legal NLP",
              "max_results": 3
            }
          }
        ]
      },
      "metadata": {
        "skill": "academic_semantic_scholar_routing",
        "difficulty": "easy",
        "what_it_tests": "Explicit Semantic Scholar request routes to the new source with the requested limit."
      }
    },
    {
      "id": "G03_source_citation_policy",
      "phase": "B",
      "suite": "group",
      "query": "Theo policy nội bộ, nguồn mạng xã hội có được dùng làm fact đã xác minh không?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "policy",
            "args": {
              "policy_area": "source_citation"
            }
          }
        ]
      },
      "metadata": {
        "skill": "internal_source_policy",
        "difficulty": "medium",
        "what_it_tests": "Internal citation-policy question uses the local policy tool instead of public web search."
      }
    },
    {
      "id": "G04_missing_paper_url",
      "phase": "B",
      "suite": "group",
      "query": "Đọc và phân tích paper trong link này giúp mình.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "text"
            }
          }
        ]
      },
      "metadata": {
        "skill": "academic_missing_url",
        "difficulty": "medium",
        "what_it_tests": "A paper-reading request without a URL asks for the missing URL and does not invent one."
      }
    },
    {
      "id": "G05_capability_question",
      "phase": "B",
      "suite": "group",
      "query": "Agent có thể tìm paper từ những nguồn học thuật nào?",
      "failure_type": "unnecessary_tool",
      "expect": {
        "no_tool": true,
        "behavior": "answer_without_tool"
      },
      "metadata": {
        "skill": "academic_meta_no_tool",
        "difficulty": "easy",
        "what_it_tests": "A capability question is answered without making a search call."
      }
    },
    {
      "id": "GM01_broad_multisource_review",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Mình muốn làm literature review về Vietnamese multimodal datasets."
        },
        {
          "role": "user",
          "content": "Hãy tìm trên nhiều nguồn học thuật."
        },
        {
          "role": "user",
          "content": "Dùng cả arXiv và Semantic Scholar với cùng chủ đề Vietnamese multimodal datasets."
        }
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "papers",
            "args": {
              "query": "Vietnamese multimodal datasets"
            }
          },
          {
            "name": "semantic_scholar",
            "args": {
              "query": "Vietnamese multimodal datasets"
            }
          }
        ]
      },
      "metadata": {
        "skill": "academic_multisource_coverage",
        "difficulty": "hard",
        "what_it_tests": "A broad multi-source review calls both academic adapters with the same carried topic."
      }
    },
    {
      "id": "GM02_correct_academic_source",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tìm paper arXiv về Vietnamese question answering."
        },
        {
          "role": "user",
          "content": "Đổi nguồn, không dùng arXiv nữa."
        },
        {
          "role": "user",
          "content": "Chỉ tìm Semantic Scholar, giữ chủ đề Vietnamese question answering."
        }
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "semantic_scholar",
            "args": {
              "query": "Vietnamese question answering"
            }
          }
        ]
      },
      "metadata": {
        "skill": "academic_source_correction",
        "difficulty": "hard",
        "what_it_tests": "The latest source correction cancels arXiv while preserving the research topic."
      }
    },
    {
      "id": "GM03_clarify_then_read_url",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tóm tắt paper này giúp mình."
        },
        {
          "role": "user",
          "content": "Link là https://arxiv.org/abs/1706.03762"
        },
        {
          "role": "user",
          "content": "Chỉ đọc đúng URL mình vừa gửi."
        }
      ],
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "fetch",
            "args": {
              "url": "https://arxiv.org/abs/1706.03762"
            }
          }
        ]
      },
      "metadata": {
        "skill": "academic_url_carryover",
        "difficulty": "medium",
        "what_it_tests": "After a URL is supplied, the latest turn uses fetch with exactly that URL."
      }
    },
    {
      "id": "GM04_arxiv_fulltext_correction",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tìm paper Attention Is All You Need."
        },
        {
          "role": "user",
          "content": "Paper có arXiv ID 1706.03762."
        },
        {
          "role": "user",
          "content": "Không cần tìm nữa, hãy lấy text 2 trang đầu."
        }
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "paper_text",
            "args": {
              "arxiv_url": "1706.03762",
              "max_pages": 2
            }
          }
        ]
      },
      "metadata": {
        "skill": "academic_search_to_fulltext",
        "difficulty": "hard",
        "what_it_tests": "The latest request switches from discovery to PDF text extraction and carries the arXiv ID."
      }
    },
    {
      "id": "GM05_require_confirmation",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Gửi báo cáo nghiên cứu lên Telegram giúp mình."
        },
        {
          "role": "user",
          "content": "Nội dung là: Báo cáo Vietnamese NLP đã hoàn thành."
        },
        {
          "role": "user",
          "content": "Hãy chuẩn bị gửi nhưng tôi chưa xác nhận."
        }
      ],
      "failure_type": "wrong_boundary",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "yes_no"
            }
          }
        ]
      },
      "metadata": {
        "skill": "academic_publish_confirmation_boundary",
        "difficulty": "hard",
        "what_it_tests": "The agent asks for confirmation and does not send while the user explicitly says confirmation has not been given."
      }
    }
  ]
}
